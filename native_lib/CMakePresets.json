{
  "version": 2,
  "configurePresets": [
    {
      "name": "vcpkg",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build",
      "cacheVariables": {
        "CMAKE_TOOLCHAIN_FILE": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake"
      }
    },
    {
      "name": "tests",
      "inherits": "vcpkg",
      "cacheVariables": {
        "VCPKG_MANIFEST_FEATURES": "test",
        "CIRCUITSOLVER_BUILD_TESTS": "ON",
        "CIRCUITSOLVER_TEST_COVERAGE": true
      }
    }
  ]
}
